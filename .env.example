# ---------------------------------------------------------------------------
# Flow Chain Document Manager — environment variables (copy to .env, never commit .env)
# Generate secrets locally:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"        -> SECRET_KEY
#   cd backend && uv run python -m app.cli gen-key                      -> FIELD_ENCRYPTION_KEYS
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true

PUBLIC_BASE_URL=http://localhost:8000      # public HTTPS URL of the API in production
DASHBOARD_URL=http://localhost:3000        # where OAuth redirects back to
CORS_ORIGINS=                              # leave empty when the dashboard proxies /api (recommended)

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/flowchain
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

SECRET_KEY=change-me-to-a-long-random-string-of-48-chars-or-more
FIELD_ENCRYPTION_KEYS=                     # comma separated Fernet keys; first encrypts
COOKIE_SECURE=false                        # MUST be true in production (HTTPS)
ALLOW_FAKE_PROVIDERS=true                  # MUST be false in production

# Worker: run inside the API process (single free instance) or as a separate process
EMBEDDED_WORKER=false
WORKER_CONCURRENCY=1

# Files
MAX_FILE_BYTES=16777216
MEDIA_BLOB_TTL_HOURS=72
PENDING_MEDIA_TTL_HOURS=24
SEARCH_SESSION_TTL_MINUTES=30
LEGACY_CONVERTER=none                      # none | soffice (requires LibreOffice in the image)

# WhatsApp (WasenderAPI). Per-connection API key + webhook secret are entered in the dashboard
WASENDER_BASE_URL=https://www.wasenderapi.com/api

# Google OAuth (Drive). Create in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI to register: ${PUBLIC_BASE_URL}/api/v1/integrations/google/callback

# Gemini (optional; AI stays OFF per tenant until the owner enables it with recorded consent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Dev/testing only: enables POST /api/v1/webhooks/whatsapp (normalized events)
INTERNAL_WEBHOOK_TOKEN=

# Shared by API and dashboard: lets the dashboard proxy relay the browser IP (X-Client-IP).
PROXY_SHARED_SECRET=

# Frontend (Next.js) — read at runtime by the /api proxy route
BACKEND_URL=http://localhost:8000
DASHBOARD_TRUSTED_PROXY_HOPS=0             # Render: 1

# Reverse proxies in front of the API appending to X-Forwarded-For (Render: 1). 0 = socket peer.
TRUSTED_PROXY_HOPS=0
