# ---------- Server ----------
PORT=3000
# Public path WasenderAPI will POST to, e.g. https://your-domain.com/webhook
WEBHOOK_PATH=/webhook

# ---------- WasenderAPI ----------
# Session API key (WasenderAPI dashboard -> your session -> API Key)
WASENDER_API_KEY=
# Webhook secret (same dashboard page). Requests without a matching
# X-Webhook-Signature header are rejected.
WASENDER_WEBHOOK_SECRET=
WASENDER_BASE_URL=https://www.wasenderapi.com/api
# Minimum gap between outgoing messages (ms). Trial plans are rate limited.
WASENDER_SEND_INTERVAL_MS=1500

# ---------- Access control ----------
# Numbers with country code, digits only, comma separated.
# Admins can rename, move, delete and create folders.
ADMIN_NUMBERS=919876543210
# Other numbers that may upload / list / search / retrieve (admins always can).
ALLOWED_NUMBERS=
# true = ANY number that messages the bot may use it (not recommended)
ALLOW_EVERYONE=false
# Reply "not authorised" to unknown numbers (false = ignore silently)
REPLY_TO_UNAUTHORIZED=false
# Process messages sent inside WhatsApp groups
ALLOW_GROUPS=false

# ---------- AI chat (optional but recommended) ----------
# Anthropic API key from https://console.anthropic.com – enables natural
# language chat ("send me last month's invoice"). Leave empty for menu-only mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high – low keeps replies fast and cheap
CLAUDE_EFFORT=low
# Retry on a fallback model if the main model declines a request
CLAUDE_FALLBACKS=true
# A chat starts fresh after this many quiet minutes
AI_SESSION_MINUTES=30
# Time zone used when the bot talks about dates
BOT_TIMEZONE=Asia/Kolkata
# Show "typing…" while the AI is thinking
SHOW_TYPING=true

# ---------- OneDrive / Microsoft Graph ----------
# AUTH MODE "delegated" = personal OneDrive or a work account signed in
#   once with `npm run login` (stores a refresh token).
# AUTH MODE "app" = OneDrive for Business with an app secret
#   (client credentials), requires MS_DRIVE_USER.
MS_AUTH_MODE=delegated
MS_CLIENT_ID=
# Only needed for "app" mode (or a confidential delegated app)
MS_CLIENT_SECRET=
# delegated: "consumers" (personal), "organizations" or your tenant id
# app: your tenant id (GUID)
MS_TENANT=consumers
# delegated mode: leave empty and send /connect from an admin WhatsApp
# number after deploying (the sign-in is saved in DATA_DIR).
MS_REFRESH_TOKEN=
# app mode: user principal name whose OneDrive is used, e.g. files@contoso.com
MS_DRIVE_USER=
# Optional: target a specific drive id instead (overrides the above)
MS_DRIVE_ID=

# ---------- Storage behaviour ----------
# Every bot path lives under this OneDrive folder
ONEDRIVE_BASE_FOLDER=WhatsApp Files
# Folder (inside the base) new uploads go to when the user has not chosen one
DEFAULT_UPLOAD_FOLDER=Inbox
# Allow non-admin users to create folders implicitly via "/save <folder>"
USERS_CAN_CREATE_FOLDERS=true
MAX_FILE_MB=100
# Seconds an admin has to confirm a delete with /yes
CONFIRM_TIMEOUT_SECONDS=120
# How long to wait for more files before sending one "saved" summary (ms)
UPLOAD_SUMMARY_DELAY_MS=4000

# ---------- Persistence ----------
# Folder for state.json (OneDrive sign-in, users' folders). Must be a
# persistent disk/volume in the cloud. The Docker image uses /app/data.
# DATA_DIR=/app/data
